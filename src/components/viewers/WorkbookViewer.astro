---
// Read-only workbook viewer. The grid is rendered at build time; the browser only switches
// sheets and shows the selected cell's formula. Workbook colors are the author's content,
// so the grid always renders on a light sheet.
import { readWorkbook, MAX_COLS, MAX_ROWS } from '../../lib/workbook';

interface Props {
  file: string;
  downloadHref: string;
}
const { file, downloadHref } = Astro.props;
const workbook = await readWorkbook(file);
// A sheet with only formatting and no values counts as empty. The viewer opens where the author left
// the workbook (its active sheet), or else on the first sheet with data.
const empty = workbook.sheets.map((sheet) => sheet.rows.every((row) => row.cells.every((cell) => !cell?.text)));
const active = workbook.sheets.findIndex((sheet) => sheet.name === workbook.activeSheet);
const initial = active >= 0 && !empty[active] ? active : Math.max(0, empty.indexOf(false));
const ROW_HEADER_WIDTH = 44;
---

<section class="workbook" data-workbook data-initial={initial} aria-label="Workbook viewer">
  <div class="workbook-tabs" role="tablist" aria-label="Sheets">
    {
      workbook.sheets.map((sheet, i) => (
        <button type="button" role="tab" id={`sheet-tab-${i}`} aria-controls={`sheet-${i}`} aria-selected={i === initial ? 'true' : 'false'} tabindex={i === initial ? 0 : -1}>
          {sheet.name}
        </button>
      ))
    }
  </div>
  <div class="formula-bar" data-pagefind-ignore>
    <span class="fx-address" data-fx-address>—</span>
    <span class="fx-label" aria-hidden="true">fx</span>
    <output class="fx-value" data-fx-value aria-live="polite">Select a cell to see its formula</output>
  </div>
  {
    workbook.sheets.map((sheet, i) => (
      <div class="sheet" role="tabpanel" id={`sheet-${i}`} aria-labelledby={`sheet-tab-${i}`} data-theme="light" data-pagefind-ignore>
        {empty[i] ? (
          <p class="sheet-empty">This sheet is empty.</p>
        ) : (
          <div class="sheet-scroll" tabindex="0" aria-label={`Sheet ${sheet.name}`}>
            <table class="sheet-grid" style={`width:${ROW_HEADER_WIDTH + sheet.columns.reduce((sum, c) => sum + c.width, 0)}px`}>
              <colgroup>
                <col class="rowhead" />
                {sheet.columns.map((c) => (
                  <col style={`width:${c.width}px`} />
                ))}
              </colgroup>
              <thead>
                <tr>
                  <th class="corner" />
                  {sheet.columns.map((c) => (
                    <th scope="col">{c.letter}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {sheet.rows.map((row) => (
                  <tr style={row.height ? `height:${row.height}px` : undefined}>
                    <th scope="row">{row.index}</th>
                    {row.cells.map((cell) =>
                      cell ? (
                        <td class:list={{ n: cell.numeric, f: !!cell.formula, filled: cell.filled, pic: cell.picture }} style={cell.style} colspan={cell.colspan} rowspan={cell.rowspan} data-a={cell.address} data-f={cell.formula} tabindex={cell.formula ? 0 : undefined} title={cell.picture ? 'Picture in cell: download the workbook to see it' : undefined}>
                          {cell.picture ? '[picture]' : cell.text}
                        </td>
                      ) : null,
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {sheet.truncated && <p class="sheet-note meta">Showing the first {MAX_ROWS} rows and {MAX_COLS} columns; the download has the rest.</p>}
      </div>
    ))
  }
  {workbook.hiddenSheets > 0 && <p class="meta sheet-hidden">{workbook.hiddenSheets} hidden {workbook.hiddenSheets === 1 ? 'sheet is' : 'sheets are'} only in the <a href={downloadHref} download>download</a>.</p>}
</section>

<style>
  .workbook {
    margin-top: 32px;
    border: 1px solid var(--rule);
    background: var(--surface);
  }
  .workbook-tabs {
    display: flex;
    gap: 2px;
    flex-wrap: wrap;
    padding: 8px 8px 0;
    background: var(--mist);
    border-bottom: 1px solid var(--rule);
  }
  .workbook-tabs button {
    flex: none;
    padding: 8px 14px;
    border: 1px solid transparent;
    border-bottom: 0;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    font-size: 13px;
    font-stretch: var(--width-meta);
    cursor: pointer;
  }
  .workbook-tabs button[aria-selected='true'] {
    background: var(--surface);
    border-color: var(--rule);
    color: var(--text-heading);
    font-weight: 600;
    margin-bottom: -1px;
  }
  .formula-bar {
    display: grid;
    grid-template-columns: 72px 36px minmax(0, 1fr);
    align-items: center;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    font-stretch: var(--width-meta);
    font-variant-numeric: tabular-nums;
  }
  .formula-bar > * {
    padding: 6px 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fx-address {
    border-right: 1px solid var(--rule);
    color: var(--ink);
    font-weight: 600;
  }
  .fx-label {
    font-style: italic;
    color: var(--slate);
    text-align: center;
    padding-inline: 0;
    text-overflow: clip;
  }
  .fx-value {
    color: var(--ink);
  }
  .sheet[hidden] {
    display: none;
  }
  .sheet-scroll {
    overflow: auto;
    max-height: max(480px, calc(100vh - 220px));
    background: var(--surface);
  }
  /* Collapsed borders merge like Excel's shared cell edges. Gridlines are inset shadows, so the
     workbook's own borders never compete with them; filled cells hide them, as in Excel. */
  .sheet-grid {
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 13px;
    line-height: 1.3;
    color: var(--ink);
  }
  .sheet-grid col.rowhead {
    width: 44px;
  }
  .sheet-grid th {
    position: sticky;
    background: var(--mist);
    color: var(--slate);
    font-weight: 400;
    font-size: 11px;
    font-stretch: var(--width-data);
    text-align: center;
    border: 0;
    box-shadow: inset -1px -1px 0 var(--rule);
    padding: 2px 4px;
  }
  .sheet-grid thead th {
    top: 0;
    z-index: 2;
  }
  .sheet-grid tbody th {
    left: 0;
    z-index: 1;
  }
  .sheet-grid .corner {
    left: 0;
    z-index: 3;
  }
  .sheet-grid td {
    height: 20px;
    padding: 1px 4px;
    box-shadow: inset -1px -1px 0 var(--grid);
    white-space: nowrap;
    overflow: visible;
    vertical-align: bottom;
  }
  .sheet-grid td.filled {
    box-shadow: none;
  }
  .sheet-grid td.pic {
    color: #5a6573;
    font-style: italic;
    font-size: 11px;
  }
  .sheet-grid td.n {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-stretch: 90%;
  }
  .sheet-grid td:focus-visible {
    outline: 2px solid var(--highlight);
    outline-offset: -2px;
  }
  .sheet-grid td.selected {
    outline: 2px solid var(--highlight);
    outline-offset: -2px;
  }
  .sheet-empty {
    padding: 48px 24px;
    text-align: center;
    color: var(--slate);
  }
  .sheet-note,
  .sheet-hidden {
    padding: 8px 12px;
    border-top: 1px solid var(--rule);
  }
  .sheet-note:empty {
    display: none;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-workbook]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const address = root.querySelector<HTMLElement>('[data-fx-address]')!;
    const value = root.querySelector<HTMLElement>('[data-fx-value]')!;
    let selected: HTMLElement | null = null;

    const show = (index: number) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
    };
    show(Number(root.dataset.initial ?? 0));
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(i));
      tab.addEventListener('keydown', (e) => {
        const moves: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
        if (!(e.key in moves)) return;
        e.preventDefault();
        const next = (moves[e.key] + tabs.length) % tabs.length;
        tabs[next].focus();
        show(next);
      });
    });

    const inspect = (e: Event) => {
      const cell = (e.target as HTMLElement).closest<HTMLElement>('td[data-a]');
      if (!cell) return;
      selected?.classList.remove('selected');
      selected = cell;
      cell.classList.add('selected');
      address.textContent = cell.dataset.a ?? '';
      value.textContent = cell.dataset.f ?? cell.textContent?.trim() ?? '';
    };
    // Click any cell, or Tab through formula cells, to see its formula or value.
    root.addEventListener('click', inspect);
    root.addEventListener('focusin', inspect);
  }
</script>
