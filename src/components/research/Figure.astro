---
import Exhibit from './Exhibit.astro';
import { fileUrl, getPublication } from '../../lib/registry';

interface Props {
  src: string;
  alt: string;
  title?: string;
  caption?: string;
  sourceRefs?: string;
  exhibit: string;
  pkg: string;
}
const p = Astro.props;
const pub = getPublication(p.pkg)!;
---

<Exhibit exhibit={p.exhibit} title={p.title} caption={p.caption} sourceRefs={p.sourceRefs}>
  <img src={fileUrl(pub, p.src)} alt={p.alt} loading="lazy" decoding="async" />
</Exhibit>
