---
// Canonical publication page: /<kind>/<id>/. The renderer is chosen by format.
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../../layouts/Base.astro';
import PublicationHeader from '../../../components/publication/PublicationHeader.astro';
import Related from '../../../components/publication/Related.astro';
import ResearchArticle from '../../../components/research/ResearchArticle.astro';
import PdfViewer from '../../../components/viewers/PdfViewer.astro';
import WorkbookViewer from '../../../components/viewers/WorkbookViewer.astro';
import ArtifactFrame from '../../../components/viewers/ArtifactFrame.astro';
import { fileUrl, getPublications, url, type Publication } from '../../../lib/registry';
import { formatBytes } from '../../../lib/format';

export function getStaticPaths() {
  return getPublications().map((pub) => ({ params: { kind: pub.manifest.kind, id: pub.id }, props: { pub } }));
}

const { pub } = Astro.props as { pub: Publication };
const m = pub.manifest;
const primaryFile = path.join(pub.dir, ...m.primary.split('/'));
const primaryHref = fileUrl(pub, m.primary);
const ext = path.extname(m.primary);
const size = formatBytes(fs.statSync(primaryFile).size);
const downloadLabel = { pdf: 'Download PDF', xlsx: 'Download workbook', jsx: 'Download source', mdx: '' }[m.format];
// A research report may bring its own PDF (the authors' original); then no A4 print is generated.
const ownPdfSize = m.pdf ? formatBytes(fs.statSync(path.join(pub.dir, ...m.pdf.split('/'))).size) : undefined;
---

<Base title={m.title} description={m.summary}>
  <div data-pagefind-body data-pagefind-meta={`kind:${m.kind}`}>
    <PublicationHeader pub={pub}>
      <Fragment slot="actions">
        {
          m.format === 'mdx' && m.pdf && (
            <a class="button" href={fileUrl(pub, m.pdf)} download={m.pdf}>
              Download original PDF <span class="meta">(PDF, {ownPdfSize})</span>
            </a>
          )
        }
        {
          m.format === 'mdx' &&
            !m.pdf &&
            (import.meta.env.DEV ? (
              <button type="button" class="button" onclick="window.print()" title="The A4 PDF file is generated by npm run build">
                Print / save as PDF
              </button>
            ) : (
              <a class="button" href={fileUrl(pub, pub.pdfFile!)} download={pub.pdfFile}>
                Download PDF (A4)
              </a>
            ))
        }
        {
          m.format !== 'mdx' && (
            <a class="button" href={primaryHref} download={`${m.id}${ext}`}>
              {downloadLabel} <span class="meta">({ext.slice(1).toUpperCase()}, {size})</span>
            </a>
          )
        }
        {
          m.format === 'pdf' && (
            <a class="button button--quiet" href={primaryHref} target="_blank" rel="noopener">
              Open in new tab
            </a>
          )
        }
      </Fragment>
    </PublicationHeader>

    {
      m.format === 'mdx' && (
        <ResearchArticle pub={pub}>
          <Related pub={pub} />
        </ResearchArticle>
      )
    }
    {
      m.format !== 'mdx' && (
        <div class="wrap">
          {m.format === 'pdf' && <PdfViewer href={primaryHref} title={m.title} />}
          {m.format === 'xlsx' && <WorkbookViewer file={primaryFile} downloadHref={primaryHref} />}
          {m.format === 'jsx' && <ArtifactFrame src={url(`${pub.path}frame.html`)} title={m.title} />}
          <Related pub={pub} />
        </div>
      )
    }
  </div>
</Base>

<style>
  .button .meta {
    color: inherit;
    opacity: 0.8;
  }
</style>
